    const dx = ll[i + 1][0] - ll[i][0], dy = ll[i + 1][1] - ll[i][1];
    const k = Math.max(1, Math.ceil(Math.hypot(dx, dy) / 0.02));
    for (let t = 0; t < k; t++) {
      const pt = [ll[i][0] + dx * t / k, ll[i][1] + dy * t / k];
      for (const f of feats) { if (d3.geoContains(f, pt)) { const r = nm[f.properties.NUTS_ID]; if (r) count.set(r, (count.get(r) || 0) + 1); } }
    }
  }
  const s = new Set();
  for (const [r, c] of count) if (c >= 5 && r !== rf && r !== rt) s.add(r);
  return s;
}
