/* ---------- Input resolution ---------- */
// Returns {region}, {ambiguous:[regionA, regionB], text}, or null.
function resolve(raw) {
  const t = (raw || '').replace(/\s*\(region\)\s*$/i, '').replace(/\s+/g, ' ').trim();
  if (!t) return null;
  const u = t.toUpperCase(), l = t.toLowerCase();
  const pcm = /^([A-Za-z]{1,2})\d[A-Za-z\d]?(\s*\d[A-Za-z]{2})?$/.exec(t);
  if (pcm && D.pcLookup[pcm[1].toUpperCase()]) { const ar = pcm[1].toUpperCase(); return { region: D.pcLookup[ar], area: ar, name: ar }; }
  const byPc = D.pcLookup[u] || null;
  const byReg =
    REGIONS.find((r) => r.toLowerCase() === l) ||
    Object.keys(D.shortToFull).find((k) => D.shortToFull[k].toLowerCase() === l) ||
    null;
  if (byPc && byReg && byPc !== byReg) return { ambiguous: [byPc, byReg], text: t };
  if (byPc || byReg) return { region: byPc || byReg, area: byPc ? u : null, name: byPc ? u : null };
  const towns = D.autocomplete.filter((a) => a.town);
  const town = towns.find((a) => a.town.toLowerCase() === l);
  if (town) return { region: town.region, area: town.pc, name: town.town };
  // the same town name in more than one region (Richmond, Newport): ask, do not guess
  const base = (n) => n.replace(/\s*\(.*\)$/, '').toLowerCase();
  const sameName = towns.filter((a) => !a.isRegion && base(a.town) === l);
  const regs = sameName.map((a) => a.region).filter((r, i, arr) => arr.indexOf(r) === i);
  if (regs.length > 1) return { ambiguousTowns: regs, text: t };
  const regPartial =
    REGIONS.find((r) => r.toLowerCase().startsWith(l)) ||
    Object.keys(D.shortToFull).find((k) => D.shortToFull[k].toLowerCase().startsWith(l));
  if (regPartial) return { region: regPartial };
  const townPartial = towns.find((a) => a.town.toLowerCase().startsWith(l));
  return townPartial ? { region: townPartial.region, area: townPartial.pc, name: townPartial.town } : null;
}

function sideOf(inputId) {
  const el = $(inputId);
  // a stored region is used only while the box still shows it; typed text always wins
  if (el.dataset.region && el.value.trim() === el.dataset.region) return { region: el.dataset.region };
  return resolve(el.value);
}

function setMsg(text) { $('searchMsg').textContent = text || ''; }

function setInputs(rf, rt) {
  [['fromInput', rf], ['toInput', rt]].forEach(([id, r]) => {
    $(id).value = r;
