  state.regLane = regLane;
  const laneNote = aLane ? ('Figures are for postcode areas ' + ep0.o.area + ' to ' + ep0.d.area + ', from 100 or more loads. The monthly chart and trends are for the whole regions.')
    : (ep0.o && ep0.d) ? ('Fewer than 100 loads between ' + ep0.o.area + ' and ' + ep0.d.area + ', so the figures are for the whole regions (' + fullName(rf) + ' to ' + fullName(rt) + ').')
    : 'Figures are for the whole regions. The places are shown for orientation.';
  const card = $('laneCard');

  const ep = endPlaceFor(rf, rt);
  let h = '<div class="lc-route"><span class="lc-region">' + esc(placeLabel(ep.o, rf)) + '</span><span class="lc-arrow">\u2192</span><span class="lc-region">' + esc(placeLabel(ep.d, rt)) + '</span></div>';
  h += '<div class="lc-full">' + esc(fullName(rf)) + ' to ' + esc(fullName(rt)) + '</div>';

  if (!lane) {
    h += '<p style="color:var(--on3)">' + (state.vt === 'all'
      ? 'No data for this corridor.'
      : (vtList.indexOf(state.vt) >= 0
        ? 'Fewer than 10 ' + esc(state.vt) + ' loads on this corridor, too few to show a rate.'
        : 'No ' + esc(state.vt) + ' loads recorded on this corridor.') + ' Choose another vehicle type.') + '</p>';
    h += '<div class="actions"><button class="act-btn primary" id="returnBtn">Return leg: ' + esc(rt) + ' \u2192 ' + esc(rf) + '</button></div>';
    card.innerHTML = h;
    wireCard(rf, rt, null);
    drawMap(rf, rt);
    drawScreenline(rf, rt);
    return;
  }

  // Rate block: median per mile with 25th to 75th percentile bar
  const barMin = Math.max(0, Math.floor(lane.p25m * 10) / 10 - 0.1);
  const barMax = Math.ceil(lane.p75m * 10) / 10 + 0.1;
  const span = barMax - barMin || 1;
  const pos = (v) => ((v - barMin) / span) * 100;
  const p25 = pos(lane.p25m), p75 = pos(lane.p75m), med = pos(lane.ppm);

  h += '<div class="rate-block"><div class="rate-hero">' +
    '<div class="rh-cell rh-main"><div class="rh-k">Typical load</div><div class="rh-v">\u00a3' + lane.med.toLocaleString('en-GB') + '</div></div>' +
    '<div class="rh-cell"><div class="rh-k">Distance</div><div class="rh-v">' + Math.round(lane.mi) + '<span class="rh-u"> miles</span></div></div>' +
    '<div class="rh-cell"><div class="rh-k">Per mile</div><div class="rh-v"><span class="pct pct-r pct-top" tabindex="0">\u00a3' + lane.ppm.toFixed(2) + '<span class="pct-pop">\u00a3' + lane.ppm.toFixed(2) + ' per mile. Roughly the typical rate: half of typical loads in this lane pay less per mile than this, and half pay more.</span></span></div></div></div>';
  h += '<div class="rate-bar"><div class="rate-bar-track"></div>' +
    '<div class="rate-bar-fill" style="left:' + p25 + '%;width:' + (p75 - p25) + '%"></div>' +
    '<span class="rate-bar-median pct" tabindex="0" style="left:' + med + '%"><span class="pct-pop">\u00a3' + lane.ppm.toFixed(2) + ' per mile. Roughly the typical rate: half of typical loads in this lane pay less per mile than this, and half pay more.</span></span>' +
    '<span class="rate-bar-label pct pct-l" tabindex="0" style="left:' + p25 + '%">\u00a3' + lane.p25m.toFixed(2) + '<span class="pct-pop">\u00a3' + lane.p25m.toFixed(2) + ' per mile. Roughly one typical load in four paid less than this. Three in four paid more.</span></span>' +
    '<span class="rate-bar-label pct pct-r" tabindex="0" style="left:' + p75 + '%">\u00a3' + lane.p75m.toFixed(2) + '<span class="pct-pop">\u00a3' + lane.p75m.toFixed(2) + ' per mile. Roughly three typical loads in four paid less than this. One in four paid more.</span></span></div>';
  h += '</div>';

  h += '<div class="facts facts4">' +
    fact('Volume', fmt(lane.n), '24 months') +
    fact('Quotes / load', lane.qpl != null ? lane.qpl.toFixed(1) : 'n/a', 'posted loads') +
    fact('YoY change', yoyStr(lane.yoy), fmt(lane.y1) + ' \u2192 ' + fmt(lane.y2), yoyCls(lane.yoy)) +
    fact('Avg mileage', lane.mi, 'miles') + '</div>';

  h += '<div class="chart-area"><div class="chart-label">Monthly volume (region)</div>' +
    '<div class="chart-legend"><span><i style="background:var(--primary)"></i>Y1</span><span><i style="background:var(--secondary)"></i>Y2</span></div>' +
    '<div id="yoyChart"></div></div>';

  h += '<div class="actions">' +
    '<button class="act-btn primary" id="returnBtn">Return leg: ' + esc(rt) + ' \u2192 ' + esc(rf) + '</button>' +
    '<button class="act-btn" id="rateBtn">Rate trend</button>' +
    '<button class="act-btn" id="seasonBtn">Seasonal</button></div>';
  if (ep.o || ep.d) h += '<details class="lc-info"><summary>About these figures</summary><p>' + laneNote + '</p></details>';
  h += '<div class="expand-section" id="rateTrend"><div class="chart-label">Rate per mile by month (region)</div><div id="rateChart"></div></div>';
  h += '<div class="expand-section" id="seasonalSection"><div class="chart-label">Quotes per load by month (region)</div><div id="qplChart"></div></div>';

  card.innerHTML = h;
  wireCard(rf, rt, lane);
  if (regLane) drawYoY(regLane.mr, $('yoyChart'));
  drawMap(rf, rt);
  drawScreenline(rf, rt);
  if (!state.quiet) $('laneView').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function fact(label, val, sub, cls) {
  return '<div class="fact"><div class="fact-label">' + label + '</div><div class="fact-val ' + (cls || '') + '">' + val + '</div><div class="fact-sub">' + sub + '</div></div>';
}

function wireCard(rf, rt, lane) {
  $('laneCard').querySelectorAll('.lc-vt').forEach((b) => b.addEventListener('click', () => setVehicle(b.dataset.lvt, true)));
  $('returnBtn').addEventListener('click', () => { setInputs(rt, rf); showLane(rt, rf); });
  if (!lane) return;
  const toggle = (sectionId, chartId, data, color, money) => {
    const s = $(sectionId);
    s.classList.toggle('open');
    if (s.classList.contains('open')) {
      if (data) drawSpk(data, $(chartId), color, money);
      else $(chartId).innerHTML = '<div style="color:var(--on3);font-size:11px">Not enough monthly data.</div>';
    }
  };
  $('rateBtn').addEventListener('click', () => toggle('rateTrend', 'rateChart', state.regLane.rm, 'var(--primary)', true));
  $('seasonBtn').addEventListener('click', () => toggle('seasonalSection', 'qplChart', state.regLane.qm, '#daa520', false));
}

function setVehicle(vt, rerender) {
  state.vt = vt;
  if ($('vSelect').value !== vt) $('vSelect').value = vt;
  if (rerender && state.from && $('laneView').style.display !== 'none') showLane(state.from, state.to);
}
$('vSelect').addEventListener('change', (e) => setVehicle(e.target.value, true));
$('goBtn').addEventListener('click', doSearch);
$('netBtn').addEventListener('click', () => {
  hideRadius();
  $('welcomeState').style.display = 'none';
  $('laneView').style.display = 'none';
  const nv = $('networkView');
  nv.classList.toggle('show');
  if (nv.classList.contains('show')) buildMatrix(state.view);
});

/* ---------- Charts ---------- */
function niceStep(range, target) {
  const r = range / (target || 5), g = Math.pow(10, Math.floor(Math.log10(r))), d = r / g;
  return (d <= 1.5 ? 1 : d <= 3 ? 2 : d <= 7 ? 5 : 10) * g;
}

function drawYoY(mr, el) {
  if (!el || !mr) return;
  const y1 = mr.slice(0, 12), y2 = mr.slice(12, 24);
  const pos = y1.concat(y2).filter((v) => v > 0);
  if (pos.length < 2) { el.innerHTML = ''; return; }
  const mx = Math.max(...pos);
  let step = niceStep(mx), top = Math.ceil(mx / step) * step, ticks = [];
  for (let t = 0; t <= top; t += step) ticks.push(t);
  if (ticks.length > 6) {
    step = niceStep(mx, 4); top = Math.ceil(mx / step) * step; ticks = [];
    for (let t = 0; t <= top; t += step) ticks.push(t);
  }
  const W = 640, H = 170, pL = 48, pR = 12, pT = 12, pB = 30, cW = W - pL - pR, cH = H - pT - pB;
  const labels = ['Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep'];
  const x = (i) => pL + ((i + 0.5) / 12) * cW, y = (v) => pT + cH - (v / top) * cH;
  let s = '<svg width="100%" viewBox="0 0 ' + W + ' ' + H + '">';
  ticks.forEach((t) => {
    s += '<line x1="' + pL + '" y1="' + y(t) + '" x2="' + (W - pR) + '" y2="' + y(t) + '" stroke="rgba(0,0,0,0.04)"/>' +
      '<text x="' + (pL - 6) + '" y="' + (y(t) + 3) + '" fill="var(--on3)" font-size="9" text-anchor="end">' + fmt(t) + '</text>';
  });
  labels.forEach((l, i) => { s += '<text x="' + x(i) + '" y="' + (H - pB + 14) + '" fill="var(--on3)" font-size="9" text-anchor="middle">' + l + '</text>'; });
  const path = (arr) => arr.map((v, i) => (i ? 'L' : 'M') + x(i) + ' ' + y(v)).join('');
  s += '<path d="' + path(y1) + '" fill="none" stroke="var(--primary)" stroke-width="1.5" opacity="0.5" stroke-linecap="round"/>';
  s += '<path d="' + path(y2) + '" fill="none" stroke="var(--secondary)" stroke-width="2" stroke-linecap="round"/>';
  y1.forEach((v, i) => { if (v > 0) s += '<circle cx="' + x(i) + '" cy="' + y(v) + '" r="2" fill="var(--primary)" opacity="0.5"/>'; });
  y2.forEach((v, i) => { if (v > 0) s += '<circle cx="' + x(i) + '" cy="' + y(v) + '" r="2.5" fill="var(--secondary)"/>'; });
  el.innerHTML = s + '</svg>';
}

function drawSpk(data, el, color, money) {
  if (!el || !data) return;
  const vals = data.filter((v) => v > 0);
  if (vals.length < 2) { el.innerHTML = '<div style="color:var(--on3);font-size:11px">Not enough monthly data.</div>'; return; }
  const mx = Math.max(...vals), mn = Math.min(...vals);
  const pad = (mx - mn) * 0.1 || 1;
  const yMin = Math.max(0, mn - pad);
  const step = niceStep(mx + pad - yMin, 3);
  const yMax = yMin + Math.ceil((mx - yMin) / step) * step;
  const ticks = [];
  for (let t = yMin; t <= yMax + 0.001 && ticks.length < 12; t += step) ticks.push(t);
  const W = 640, H = 120, pL = 48, pR = 12, pT = 10, pB = 28, cW = W - pL - pR, cH = H - pT - pB;
  const x = (i) => pL + ((i + 0.5) / data.length) * cW;
  const y = (v) => pT + cH - ((v - yMin) / (yMax - yMin)) * cH;
  let s = '<svg width="100%" viewBox="0 0 ' + W + ' ' + H + '">';
  ticks.forEach((t) => {
    s += '<line x1="' + pL + '" y1="' + y(t) + '" x2="' + (W - pR) + '" y2="' + y(t) + '" stroke="rgba(0,0,0,0.04)"/>' +
      '<text x="' + (pL - 6) + '" y="' + (y(t) + 3) + '" fill="var(--on3)" font-size="9" text-anchor="end">' + (money ? '\u00a3' + t.toFixed(2) : t.toFixed(1)) + '</text>';
  });
  D.months.forEach((l, i) => {
    if (i % 4 === 0 || i === D.months.length - 1)
      s += '<text x="' + x(i) + '" y="' + (H - pB + 14) + '" fill="var(--on3)" font-size="8" text-anchor="middle">' + l + '</text>';
  });
  let p = '';
  data.forEach((v, i) => { if (v > 0) p += (p ? 'L' : 'M') + x(i) + ' ' + y(v); });
  s += '<path d="' + p + '" fill="none" stroke="' + color + '" stroke-width="2" stroke-linecap="round"/>';
  data.forEach((v, i) => { if (v > 0) s += '<circle cx="' + x(i) + '" cy="' + y(v) + '" r="2" fill="' + color + '"/>'; });
  el.innerHTML = s + '</svg>';
}

/* ---------- Map and pass-through ---------- */
function drawMap(rf, rt) {
  const ct = $('mapPanel');
  if (typeof d3 === 'undefined') { ct.innerHTML = '<div style="color:var(--on3);font-size:11px;padding:20px">Map requires internet</div>'; return; }
  ct.innerHTML = '';
  const nm = D.nutsMap;
  const feats = D.geo.features.filter((f) => { const id = f.properties.NUTS_ID; return id && id.startsWith('UK') && id.length === 3; });
  if (!feats.length) return;
  const key = rf + '|' + rt, route = D.routes[key], rPath = route ? route[0] : null;
  const W = 348, H = 440;
  const proj = d3.geoMercator().fitExtent([[8, 8], [W - 8, H - 8]], { type: 'FeatureCollection', features: feats });
  const svg = d3.select(ct).append('svg').attr('viewBox', '0 0 ' + W + ' ' + H);
  let VIA = new Set();

  svg.selectAll('path').data(feats).enter().append('path')
    .attr('class', (f) => {
      const r = nm[f.properties.NUTS_ID];
      if (!r) return 'map-region';
      if (r === rf) return 'map-region origin';
      if (r === rt) return 'map-region dest';
      if (VIA && VIA.has(r)) return 'map-region via';
      return 'map-region';
    })
    .attr('d', d3.geoPath().projection(proj))
    .on('click', (ev, f) => {
      const r = nm[f.properties.NUTS_ID];
      if (!r) return;
      if (r === rt) { setInputs(rt, rf); showLane(rt, rf); }   // clicking the destination swaps direction
      else if (r !== rf) { setInputs(rf, r); showLane(rf, r); } // otherwise keep origin, change destination
    });

  const names = rPath || [rf, rt];
  const epl = endPlaceFor(rf, rt);
  const ptOf = (r, i) => {
    const pl = i === 0 ? epl.o : (i === names.length - 1 ? epl.d : null);
    if (pl && D.radiusCentroids[pl.area]) { const c = D.radiusCentroids[pl.area]; return proj([c[1], c[0]]); }
    return proj(D.regionAnchor[r]);
  };
  const pts = names.map((r, i) => ptOf(r, i)).filter(Boolean);
  const llOf = (r, i) => { const pl = i === 0 ? epl.o : (i === names.length - 1 ? epl.d : null); if (pl && D.radiusCentroids[pl.area]) { const c = D.radiusCentroids[pl.area]; return [c[1], c[0]]; } return D.regionAnchor[r]; };
  const routedLL = landRoute(names.map((r, i) => llOf(r, i)).filter(Boolean));
  const pathPts = routedLL ? routedLL.map((ll) => proj(ll)) : null;
  VIA = new Set(names.slice(1, -1));   // shade the named road corridor, not whatever the schematic line crosses
  window.LAST_VIA = Array.from(VIA).sort();
  svg.selectAll('path.map-region').attr('class', (f) => {
    const r = nm[f.properties.NUTS_ID];
    if (!r) return 'map-region';
    if (r === rf) return 'map-region origin';
    if (r === rt) return 'map-region dest';
    return VIA.has(r) ? 'map-region via' : 'map-region';
  });
  if (pts.length > 1) {
    svg.append('path').attr('d', d3.line().x((d) => d[0]).y((d) => d[1])(pathPts || [])).attr('class', 'map-route-line');
    pts.forEach((pt, i) => {
      const col = i === 0 ? 'var(--primary)' : i === pts.length - 1 ? 'var(--secondary)' : 'var(--green)';
      svg.append('circle').attr('cx', pt[0]).attr('cy', pt[1]).attr('r', 4).attr('fill', col).attr('stroke', 'var(--on)').attr('stroke-width', 1);
    });
  }
  names.forEach((r, i) => {
    const pt = ptOf(r, i);
    if (pt) svg.append('text').attr('x', pt[0]).attr('y', pt[1] - 8).attr('class', 'map-label').text((i === 0 && epl.o) ? epl.o.name : (i === names.length - 1 && epl.d) ? epl.d.name : (D.regionTown[r] || r));
  });

  if (route) {
    // Leg volumes follow the vehicle filter: all types uses the corridor totals,
    // a selected type uses that type's own lane on each leg and on the direct lane.
    const vt = state.vt, isAll = vt === 'all';
    const legs = route[1].map((s) => {
      if (isAll) return { s: s, n: s[2], q: s[4], hidden: false };
      const l = D.lanes[s[0] + '|' + s[1] + '|' + vt];
      return { s: s, n: l ? l.n : 0, q: l ? l.qpl : null, hidden: !l };   // lanes under 10 loads are suppressed
    });
    const total = legs.reduce((a, g) => a + g.n, 0);
    const dl = isAll ? D.matrix[key] : D.lanes[key + '|' + vt];
    const directN = dl ? dl.n : 0;
    const hiddenLegs = legs.filter((g) => g.hidden).length;
    const maxSeg = Math.max.apply(null, legs.map((g) => g.n));
    let ph = '<div class="passthrough"><div class="pt-title">Route via ' + route[1].map((s) => esc(s[3])).join(', ') +
      (isAll ? '' : ' (' + esc(vt) + ' only)') + '</div>';
    legs.forEach((g) => {
      const s = g.s, pct = maxSeg > 0 ? (g.n / maxSeg) * 100 : 0;
      ph += '<div class="pt-seg"><span class="pt-seg-from">' + esc(s[0]) + '</span><span class="pt-seg-arrow">\u2192</span><span class="pt-seg-to">' + esc(s[1]) + '</span>' +
        '<span class="pt-seg-road">' + esc(s[3]) + '</span><div class="pt-seg-bar"><div class="pt-seg-fill" style="width:' + pct + '%"></div></div>' +
        '<span class="pt-seg-vol">' + (g.hidden ? '&lt;10' : fmt(g.n)) + '</span>' +
        '<span style="font-size:10px;color:var(--on3);min-width:32px;text-align:right">' + (g.q != null ? g.q.toFixed(1) : 'n/a') + ' q</span></div>';
    });
    const mult = directN > 0 ? (total / directN) : null;
    ph += '<div class="pt-totals">' +
      '<div class="pt-t"><div class="pt-t-val" style="color:var(--on3)">' + (dl ? fmt(directN) : '&lt;10') + '</div><div class="pt-t-label">Point to point</div></div><div class="pt-div"></div>' +
      '<div class="pt-t"><div class="pt-t-val" style="color:var(--green)">' + fmt(total) + '</div><div class="pt-t-label">Loads along route</div></div><div class="pt-div"></div>' +
      '<div class="pt-t"><div class="pt-t-val" style="color:var(--primary)">' + (mult == null ? 'n/a' : (mult < 10 ? mult.toFixed(1) : Math.round(mult)) + 'x') + '</div><div class="pt-t-label">x point to point</div></div></div>';
    if (hiddenLegs) ph += '<div style="font-size:10px;color:var(--on3);margin-top:8px">' + hiddenLegs + ' leg' + (hiddenLegs > 1 ? 's' : '') + ' with under 10 ' + esc(vt) + ' loads not counted.</div>';
    ph += '</div>';
    ct.insertAdjacentHTML('beforeend', ph);
  } else {
  }
}

/* ---------- Public HGV screenline panel (DfT count points) ----------
   Observed public data only. Built offline by build_screenlines.py from the DfT
   AADF file and embedded as D.screenlines. Hidden when no data is embedded. */
function screenlineFor(rf, rt) {
  const S = D.screenlines;
  if (!S || rf === rt) return null;
  const keys = Object.keys(S);
  for (let i = 0; i < keys.length; i++) {
    const s = S[keys[i]];
    if (s.regions.indexOf(rf) >= 0 || s.regions.indexOf(rt) >= 0) return s;
  }
  return null;
}

function drawScreenline(rf, rt) {
  const old = $('slBlock');
  if (old) old.remove();
  const s = screenlineFor(rf, rt);
  if (!s) return;
  const yr = s.years.indexOf(state.slYear) >= 0 ? state.slYear : s.years[s.years.length - 1];
  state.slYear = yr;
  const tot = (g) => g.years[String(yr)];
  const maxShare = Math.max.apply(null, s.groups.map((g) => (tot(g) ? tot(g).hgv_share : 0))) || 1;
  let h = '<div class="sl" id="slBlock"><div class="sl-head"><span class="sl-title">' + esc(s.title) + '</span><span class="sl-tag">Public data: DfT</span></div>';
  h += '<div class="sl-yrs">' + s.years.map((y) => '<button class="nv-btn' + (y === yr ? ' active' : '') + '" data-slyear="' + y + '">' + y + '</button>').join('') + '</div>';
  s.groups.forEach((g) => {
    const t = tot(g);
    if (!t) return;
    const est = t.links - t.counted;
    h += '<div class="sl-row"><div class="sl-lab">' + esc(g.label) + '</div>' +
      '<div class="sl-bar"><div class="sl-fill" style="width:' + (t.hgv_share / maxShare * 100) + '%"></div></div>' +
      '<div class="sl-pct">' + t.hgv_share.toFixed(0) + '%</div></div>' +
      '<div class="sl-sub">' + fmt(t.hgv) + ' HGVs/day, ' + fmt(t.artic) + ' 5-6 axle artics/day' +
      (est > 0 ? '. ' + est + ' of ' + t.links + ' link' + (t.links > 1 ? 's' : '') + ' estimated, not counted' : '') + '</div>';
  });
  h += '<details class="sl-more"><summary>About these counts</summary><div class="sl-note">' + esc(s.note) + '</div></details></div>';
  $('mapPanel').insertAdjacentHTML('beforeend', h);
  $('slBlock').addEventListener('click', (e) => {
    const b = e.target.closest('[data-slyear]');
    if (b) { state.slYear = Number(b.dataset.slyear); drawScreenline(rf, rt); }
  });
}

/* ---------- Full network matrix ---------- */
function buildMatrix(view) {
  state.view = view || state.view;
  document.querySelectorAll('.nv-btn').forEach((b) => b.classList.toggle('active', b.dataset.nv === state.view));
  const isY = state.view === 'yoy';
  const bg = (v) => {
    if (v == null) return 'rgba(0,0,0,0.02)';
    if (isY) return v <= -15 ? '#de1a1a' : v <= -5 ? 'rgba(222,26,26,0.35)' : v <= 5 ? 'rgba(0,0,0,0.06)' : v <= 15 ? 'rgba(4,149,111,0.35)' : '#04956f';
    return v < 1500 ? 'rgba(6,129,240,0.08)' : v < 3000 ? 'rgba(6,129,240,0.15)' : v < 6000 ? 'rgba(6,129,240,0.25)' : v < 12000 ? 'rgba(6,129,240,0.4)' : 'rgba(6,129,240,0.6)';
  };
  const tc = (v) => (v == null ? 'var(--on3)' : isY ? (v <= -15 || v > 15 ? '#fff' : 'var(--on)') : v < 6000 ? 'var(--on2)' : '#06325f');
  const label = (v) => (v == null ? '-' : isY ? (v > 0 ? '+' : '') + v.toFixed(0) + '%' : fmt(v));
  let h = '<table class="hm"><thead><tr><th class="rh"></th>' + REGIONS.map((r) => '<th>' + esc(r) + '</th>').join('') + '</tr></thead><tbody>';
  REGIONS.forEach((rf) => {
    h += '<tr><th class="rh">' + esc(rf) + '</th>';
    REGIONS.forEach((rt) => {
      const m = D.matrix[rf + '|' + rt];
