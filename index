  });
  setMsg('');
}

/* ---------- Autocomplete dropdowns ---------- */
function buildDropdown(inputId, dropId) {
  const input = $(inputId), drop = $(dropId);
  let active = -1;

  const close = () => { drop.classList.remove('show'); active = -1; };
  const items = () => Array.from(drop.querySelectorAll('.dd-item'));
  const paint = () => {
    items().forEach((it, i) => it.classList.toggle('active', i === active));
    const cur = items()[active];
    if (cur) cur.scrollIntoView({ block: 'nearest' });
  };

  function filter(val) {
    const v = (val || '').toLowerCase().replace(/\s+/g, ' ').trim();
    if (!v) return close();
    const rank = (a) => {
      const pc = a.pc.toLowerCase(), town = (a.town || '').toLowerCase(), reg = (a.region || '').toLowerCase();
      if (a.isRegion && (pc.startsWith(v) || town.startsWith(v))) return 0; // regions first
      if (pc === v) return 1;
      if (town.startsWith(v)) return 2;
      if (pc.startsWith(v)) return 3;
      if (reg.startsWith(v)) return 4;
      if (town.includes(v)) return 5;
      return 99;
    };
    const matches = D.autocomplete
      .map((a, i) => ({ a, i, r: rank(a) }))
      .filter((x) => x.r < 99)
      .sort((x, y) => x.r - y.r || x.i - y.i)
      .slice(0, 8)
      .map((x) => x.a);
    if (!matches.length) return close();
    active = -1;
    drop.innerHTML = matches.map((m) => {
      const label = m.town || m.pc;
      const main = m.isRegion ? label + ' (region)' : label;
      const sub = m.isRegion ? '' : m.region;
      return '<div class="dd-item" data-label="' + esc(label) + '" data-region="' + esc(m.region) + '">' +
        '<div><span class="dd-item-main">' + esc(main) + '</span> <span class="dd-item-sub">' + esc(sub) + '</span></div>' +
        '<span class="dd-item-pc">' + esc(m.pc) + '</span></div>';
    }).join('');
    drop.classList.add('show');
  }

  function choose(item) {
    input.value = item.dataset.label;
    input.dataset.region = item.dataset.region;
    setMsg('');
    close();
    if (inputId === 'fromInput') $('toInput').focus(); else doSearch();
  }

  input.addEventListener('input', () => { delete input.dataset.region; setMsg(''); filter(input.value); });
  input.addEventListener('focus', () => { if (input.value && !input.dataset.region) filter(input.value); });
  drop.addEventListener('click', (e) => { const it = e.target.closest('.dd-item'); if (it) choose(it); });
  input.addEventListener('keydown', (e) => {
    const open = drop.classList.contains('show') && items().length;
    if (open && e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, items().length - 1); paint(); return; }
    if (open && e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, -1); paint(); return; }
    if (e.key === 'Escape') { close(); return; }
    if (e.key === 'Enter') {
      e.preventDefault();
      if (open && active >= 0) { choose(items()[active]); return; }
      close();
      if (inputId === 'fromInput' && !$('toInput').value.trim()) $('toInput').focus(); else doSearch();
    }
  });
  document.addEventListener('click', (e) => { if (!e.target.closest('.search-field')) close(); });
}
buildDropdown('fromInput', 'fromDrop');
buildDropdown('toInput', 'toDrop');

function doSearch() {
  hideRadius();
  const fromTxt = $('fromInput').value.trim(), toTxt = $('toInput').value.trim();
  if (!fromTxt || !toTxt) return setMsg('Enter both ends of the lane.');
  const o = sideOf('fromInput'), d = sideOf('toInput');
  for (const [side, txt] of [[o, fromTxt], [d, toTxt]]) {
    if (!side) return setMsg('Could not match "' + txt + '" to a region, postcode area or town.');
    if (side.ambiguousTowns) return setMsg('"' + side.text + '" is a town in more than one region (' + side.ambiguousTowns.map(fullName).join(' and ') + '). Pick one from the list.');
    if (side.ambiguous) {
      const [a, b] = side.ambiguous;
      return setMsg('"' + side.text + '" matches the ' + side.text.toUpperCase() + ' postcode area (' + fullName(a) +
        ') and the ' + fullName(b) + ' region. Pick one from the list.');
    }
  }
  setMsg('');
  state.endPlaces = {
    o: o.area ? { name: o.name || o.area, area: o.area, region: o.region } : null,
    d: d.area ? { name: d.name || d.area, area: d.area, region: d.region } : null
  };
  showLane(o.region, d.region);
